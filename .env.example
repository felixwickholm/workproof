# Optional. Without these keys Tryout runs on its scripted designer and keeps data in .data/store.json.
# A key set here switches the live AI on at the next start; `npm run check:ai` tests it.

# Lets Claude draft tasks and follow-up questions. The scripted designer answers when unset or on any error.
ANTHROPIC_API_KEY=
# Claude model id. Defaults to claude-opus-5-5.
ANTHROPIC_MODEL=
# Lets Gemini draft tasks and follow-up questions. GOOGLE_API_KEY is read too when this is unset.
GEMINI_API_KEY=
# Gemini model id, Gemini 3 or newer. Defaults to gemini-3.8-flash.
GEMINI_MODEL=
# Picks the designer: claude, gemini or scripted. Unset means Claude when its key exists, else Gemini, else scripted.
AI_PROVIDER=
# Lets ElevenLabs speak and transcribe through the server. The browser voice is used when unset.
ELEVENLABS_API_KEY=
# ElevenLabs voice id for spoken questions. A default voice is used when unset.
ELEVENLABS_VOICE_ID=
# Path of the JSON data file, or "off" to keep data in memory only. Defaults to .data/store.json.
PROOF_DATA_FILE=
