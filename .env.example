# Optional. Without these keys Tryout runs on its scripted designer and in-memory store.

# Lets Claude draft tasks and summaries. The scripted designer answers when unset or on any error.
ANTHROPIC_API_KEY=
# Claude model id. Defaults to claude-opus-5-5.
ANTHROPIC_MODEL=
# Reserved for a MongoDB store. Not used yet; data stays in memory and in .data/store.json.
MONGODB_URI=
# Reserved for speech-to-text of spoken answers. Not used yet.
ELEVENLABS_API_KEY=
# Reserved for describing uploaded media. Not used yet.
GEMINI_API_KEY=
# Reserved for media uploads. Not used yet.
CLOUDINARY_URL=
# Path of the JSON data file, or "off" to keep data in memory only. Defaults to .data/store.json.
PROOF_DATA_FILE=
